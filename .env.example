# Copy this file to ".env" and fill it with real values.
# Do not commit real secrets. Keep this file aligned with "src/env.js" and README.md.

# ==============================================================================
# Database & Core
# ==============================================================================
# Prisma database connection string (use "file:./db.sqlite" for local development).
DATABASE_URL="file:./db.sqlite"
# Single public base URL for the app (links and Mercado Pago back_urls).
# Set to "http://localhost:3000" locally, tunnel origin if testing webhooks, or production URL in deploy.
URL="http://localhost:3000"
# Node environment mode: "development", "test", or "production".
NODE_ENV="development"
# Optional local web server port (defaults to 3000).
PORT="3000"

# ==============================================================================
# Mercado Pago Payments & Webhooks
# ==============================================================================
# Mercado Pago API access token used to create preferences and query payments.
MERCADOPAGO_TOKEN=""
# Secret used to validate Mercado Pago webhook signatures (required in production).
WEBHOOK_SECRET=""
# Optional alternative base URL for incoming webhooks (defaults to URL if omitted).
WEBHOOK_URL=""

# ==============================================================================
# Convex Backend & Authentication
# ==============================================================================
# Convex deployment cloud origin (printed by `npx convex dev`, e.g. https://xxx.convex.cloud).
NEXT_PUBLIC_CONVEX_URL=""
# Convex deployment HTTP action origin (e.g. https://xxx.convex.site).
NEXT_PUBLIC_CONVEX_SITE_URL=""
# Frontend origin accepted by Better Auth (typically "http://localhost:3000" in dev).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Shared secret for the Next.js webhook route to confirm payments in Convex.
# Must match MERCADOPAGO_WEBHOOK_SERVICE_SECRET set on the Convex deployment (`npx convex env set`).
MERCADOPAGO_WEBHOOK_SERVICE_SECRET=""

# ==============================================================================
# Public Prices & Behavior (Defaults applied if omitted)
# ==============================================================================
# Maximum days in advance a voucher date can be selected (default: 30).
NEXT_PUBLIC_MAX_INTENDED_DAYS="30"
# Base price in BRL for standard voucher (default: 50).
NEXT_PUBLIC_VOUCHER_PRICE="50"
# Base price in BRL for voucher with pool access (default: 70).
NEXT_PUBLIC_POOL_VOUCHER_PRICE="70"
# Optional alert/announcement banner displayed across the client app.
NEXT_PUBLIC_ALERT_MESSAGE=""
# Toggle Vercel Analytics tracking on or off ("true" or "false", default: false).
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
# Vercel-injected deployment preview URL (optional locally).
NEXT_PUBLIC_VERCEL_URL=""
# Vercel-injected production URL (optional locally).
NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL=""

# ==============================================================================
# Public Info Topics (Landing page attraction overrides; optional)
# ==============================================================================
# Topic: Cachoeira
NEXT_PUBLIC_INFO_CACHOEIRA_TITLE="Cachoeira"
NEXT_PUBLIC_INFO_CACHOEIRA_DESCRIPTION="Aproveite o contato direto com a natureza em uma cachoeira privilegiada de Pirenopolis-GO."
NEXT_PUBLIC_INFO_CACHOEIRA_IMAGE="/images/principais/cachoeira-principal.png"

# Topic: Restaurante e Bar Pe de Serra
NEXT_PUBLIC_INFO_RESTAURANTE_BAR_PE_DE_SERRA_TITLE="Restaurante e bar Pe de Serra"
NEXT_PUBLIC_INFO_RESTAURANTE_BAR_PE_DE_SERRA_DESCRIPTION="Comida de qualidade, atendimento acolhedor e estrutura para completar o seu passeio."
NEXT_PUBLIC_INFO_RESTAURANTE_BAR_PE_DE_SERRA_IMAGE="/images/principais/quiosque.png"

# Topic: Piscina
NEXT_PUBLIC_INFO_PISCINA_TITLE="Piscina"
NEXT_PUBLIC_INFO_PISCINA_DESCRIPTION="Area de piscina para adultos e criancas curtirem o dia com conforto."
NEXT_PUBLIC_INFO_PISCINA_IMAGE="/images/principais/piscina-drone.png"

# Topic: Praia
NEXT_PUBLIC_INFO_PRAIA_TITLE="Praia"
NEXT_PUBLIC_INFO_PRAIA_DESCRIPTION="Espaco de praia para descansar, tomar sol e aproveitar o visual natural."
NEXT_PUBLIC_INFO_PRAIA_IMAGE="/images/principais/praia.jpg"

# Topic: Bar Pe na Areia
NEXT_PUBLIC_INFO_BAR_PE_NA_AREIA_TITLE="Bar pe na areia"
NEXT_PUBLIC_INFO_BAR_PE_NA_AREIA_DESCRIPTION="Bebidas e petiscos perto da area de lazer para voce relaxar sem pressa."
NEXT_PUBLIC_INFO_BAR_PE_NA_AREIA_IMAGE="/images/principais/piscinas-naturais.png"

# Topic: Redeiro
NEXT_PUBLIC_INFO_REDEIRO_TITLE="Redeiro"
NEXT_PUBLIC_INFO_REDEIRO_DESCRIPTION="Area com redes para descansar entre um mergulho e outro."
NEXT_PUBLIC_INFO_REDEIRO_IMAGE="/images/principais/redario.png"

# ==============================================================================
# Optional Marketing & Notifications
# ==============================================================================
# Meta Pixel ID used by webhook server-side Conversions API.
FACEBOOK_PIXEL_ID=""
# Meta Conversions API access token.
FACEBOOK_ACCESS_TOKEN=""
# Meta Pixel ID used by client-side browser tracking.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=""
# Google Analytics 4 Measurement Protocol Measurement ID.
GOOGLE_ANALYTICS_MEASUREMENT_ID=""
# Google Analytics 4 Measurement Protocol API Secret.
GOOGLE_ANALYTICS_API_SECRET=""
# Twilio Account SID for admin WhatsApp dispatch.
TWILIO_ACCOUNT_SID=""
# Twilio Auth Token for admin WhatsApp dispatch.
TWILIO_AUTH_TOKEN=""

# ==============================================================================
# Optional Sentry Monitoring & Source Maps
# ==============================================================================
# Client-side Sentry DSN for browser crash and performance reporting.
NEXT_PUBLIC_SENTRY_DSN=""
# Server-side Sentry DSN for Node.js/Edge runtime reporting.
SENTRY_DSN=""
# Server environment tag (e.g. "development", "staging", "production").
SENTRY_ENVIRONMENT="development"
# Client environment tag.
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
# Server-side performance transaction sample rate (0.0 to 1.0).
SENTRY_TRACES_SAMPLE_RATE="0.1"
# Client-side performance transaction sample rate (0.0 to 1.0).
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.05"
# Sentry auth token (required during CI builds to upload sourcemaps).
SENTRY_AUTH_TOKEN=""
# Sentry organization slug for sourcemap uploads.
SENTRY_ORG=""
# Sentry project slug for sourcemap uploads.
SENTRY_PROJECT=""
