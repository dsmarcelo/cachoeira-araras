# Copy this file to ".env" and fill it with real values.
# Do not commit real secrets. Keep this file aligned with "src/env.js" and README.md.
#
# Legend:
#   [required] validated by src/env.js; the app does not boot without it.
#   [optional] safe to leave empty or remove; a default or fallback applies.

# ==============================================================================
# Core
# ==============================================================================
# [optional] Legacy PostgreSQL URL, read only by the Convex importer, Prisma
# and the payment E2E script. Not validated by src/env.js.
# DATABASE_URL="postgresql://user:password@localhost:5432/cachoeira_araras"
# [optional] Public app origin, read only by the payment E2E script. The app
# reads SITE_URL from the Convex deployment (see the last section).
# SITE_URL="http://localhost:3000"
# [optional] Set automatically by Next.js ("development", "test", "production").
# NODE_ENV="development"

# ==============================================================================
# Mercado Pago Payments & Webhooks
# ==============================================================================
# [required] Mercado Pago API access token (webhook route queries payments).
# Also set it on the Convex deployment, which creates the payments.
MERCADOPAGO_TOKEN=""
# [required in production, optional in dev] Validates Mercado Pago webhook signatures.
WEBHOOK_SECRET=""

# [required for payments] Mercado Pago public key of the payment page (/pagar).
# It must belong to the same application and environment (test or production)
# as MERCADOPAGO_TOKEN, here and on Convex. Never put the access token in a
# NEXT_PUBLIC_ variable: those reach the browser.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# ==============================================================================
# Convex Backend & Authentication
# ==============================================================================
# [required] Convex cloud origin (printed by `npx convex dev`, e.g. https://xxx.convex.cloud).
NEXT_PUBLIC_CONVEX_URL=""
# [required] Convex HTTP action origin (e.g. https://xxx.convex.site).
NEXT_PUBLIC_CONVEX_SITE_URL=""
# [required] Shared secret for the webhook route to confirm payments in Convex.
# Must match MERCADOPAGO_WEBHOOK_SERVICE_SECRET on the Convex deployment.
MERCADOPAGO_WEBHOOK_SERVICE_SECRET=""

# ==============================================================================
# Prices & Behavior (all optional)
# ==============================================================================
# [optional] Standard voucher price in BRL (default: 70). Dot or comma decimals.
# Set the same value on the Convex deployment; checkout reads it there.
# Values below R$ 0,01 charge R$ 0,01.
# NEXT_PUBLIC_VOUCHER_PRICE="70"
# [optional] Pool voucher price in BRL (default: 70). Same rules as above.
# NEXT_PUBLIC_POOL_VOUCHER_PRICE="70"
# [optional] "true" enables Vercel Analytics (default: "false").
# NEXT_PUBLIC_ENABLE_ANALYTICS="false"
# [optional] Injected by Vercel; used for OG image URLs. Leave empty locally.
# NEXT_PUBLIC_VERCEL_URL=""
# NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL=""

# ==============================================================================
# Landing Page Info Topics (all optional; built-in defaults apply)
# ==============================================================================
# Each topic accepts _TITLE, _DESCRIPTION and _IMAGE overrides:
# NEXT_PUBLIC_INFO_CACHOEIRA_{TITLE,DESCRIPTION,IMAGE}
# NEXT_PUBLIC_INFO_RESTAURANTE_BAR_PE_DE_SERRA_{TITLE,DESCRIPTION,IMAGE}
# NEXT_PUBLIC_INFO_PISCINA_{TITLE,DESCRIPTION,IMAGE}
# NEXT_PUBLIC_INFO_PRAIA_{TITLE,DESCRIPTION,IMAGE}
# NEXT_PUBLIC_INFO_BAR_PE_NA_AREIA_{TITLE,DESCRIPTION,IMAGE}
# NEXT_PUBLIC_INFO_REDEIRO_{TITLE,DESCRIPTION,IMAGE}
# Example:
# NEXT_PUBLIC_INFO_PRAIA_TITLE="Praia"

# ==============================================================================
# Marketing (all optional; tracking is skipped when empty)
# ==============================================================================
# Meta Pixel ID + Conversions API token used by the webhook (server-side).
# FACEBOOK_PIXEL_ID=""
# FACEBOOK_ACCESS_TOKEN=""
# Meta Pixel ID for browser tracking.
# NEXT_PUBLIC_FACEBOOK_PIXEL_ID=""
# GA4 Measurement Protocol credentials.
# GOOGLE_ANALYTICS_MEASUREMENT_ID=""
# GOOGLE_ANALYTICS_API_SECRET=""

# ==============================================================================
# Sentry (all optional; disabled when DSNs are empty)
# ==============================================================================
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT="development"
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
# Sample rates between 0.0 and 1.0.
# SENTRY_TRACES_SAMPLE_RATE="0.1"
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.05"
# Build-time only: sourcemap upload in CI.
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# ==============================================================================
# Convex deployment variables (NOT read from this file)
# ==============================================================================
# Set with `pnpm exec convex env set <NAME>` on each deployment (dev and prod).
# See "Autenticacao do admin" in README.md.
#   [required] BETTER_AUTH_SECRET                 Better Auth signing secret.
#   [required] SITE_URL                           Public app origin, no path: Better
#                                                 Auth base URL, Mercado Pago back_urls
#                                                 and webhook. Use a tunnel origin to
#                                                 receive webhooks locally.
#   [required] MERCADOPAGO_TOKEN                  Creates and queries payments (same
#                                                 environment as the public key).
#   [required] MERCADOPAGO_WEBHOOK_SERVICE_SECRET Same value as above.
#   [optional] AUTH_TRUSTED_ORIGINS               Extra comma-separated origins.
#   [optional] ADMIN_USERNAME / ADMIN_PASSWORD    Seed the admin account.
#   [optional] NEXT_PUBLIC_VOUCHER_PRICE          Price override (default: 70).
#   [optional] NEXT_PUBLIC_POOL_VOUCHER_PRICE     Price override (default: 70).
